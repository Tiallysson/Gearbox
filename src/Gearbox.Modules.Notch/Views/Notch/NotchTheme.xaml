<ResourceDictionary
    x:Class="Gearbox.Modules.Notch.Views.Notch.NotchTheme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Visual da ilha no estilo shadcn/ui (tema "neutral" escuro da v4): cinzas neutros, bordas e fundos brancos
        translúcidos (deixam o acrílico aparecer), cantos de 6–8 px e nada do visual do Windows (borda de elevação,
        acento azul). Os templates próprios abaixo substituem os do WinUI; Slider e ListView usam lightweight styling.
    -->

    <!-- Paleta -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#A1A1A1" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#CECECE" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#171717" />
    <SolidColorBrush x:Key="PrimaryTrackBrush" Color="#33E5E5E5" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="#FF6467" />
    <!-- muted / accent / input: brancos translúcidos sobre o tom escuro da ilha. -->
    <SolidColorBrush x:Key="MutedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="InputFillBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#13FFFFFF" />
    <SolidColorBrush x:Key="ShadBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="RingBrush" Color="#737373" />
    <SolidColorBrush x:Key="PopoverBrush" Color="#171717" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#66A1A1A1" />

    <!--
        Borda de 1 px da ilha ("liquid glass"): por cima do fundo, nos lados e embaixo (o topo encosta na tela).
    -->
    <!--
        Reflexo horizontal: branco 8% até o meio, subindo a 25% no lado direito. As pontas viram cores próprias porque
        as orelhas (cantos côncavos de cima) continuam a borda: a da esquerda com a cor inicial, a da direita com a final.
    -->
    <Color x:Key="GlassEdgeStartColor">#14FFFFFF</Color>
    <Color x:Key="GlassEdgeEndColor">#40FFFFFF</Color>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource GlassEdgeStartColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource GlassEdgeStartColor}" />
        <GradientStop Offset="1" Color="{StaticResource GlassEdgeEndColor}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeStartBrush" Color="{StaticResource GlassEdgeStartColor}" />
    <SolidColorBrush x:Key="GlassEdgeEndBrush" Color="{StaticResource GlassEdgeEndColor}" />

    <!-- Base dos botões: fundo, borda e texto vêm dos estilos; os estados mudam só o fundo e o texto. -->
    <Style x:Key="ShadButtonBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.15" />
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- variant="ghost": só o fundo ao passar o mouse. -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadButtonBaseStyle}" />

    <!-- variant="outline": borda "input" e fundo "input/30". -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBrush}" />
    </Style>

    <!--
        Toggle: desligado = outline; ligado = primary (fundo claro, texto escuro), como um Button "default" do shadcn.
        Também é a base das abas, que só trocam as cores.
    -->
    <Style x:Key="ShadToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.15" />
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        TabsTrigger: inativa = texto "muted-foreground" sem fundo; ativa = fundo "input/30", borda "input" e texto
        "foreground" (como as Tabs do shadcn no tema escuro). Fica dentro de uma TabsList (fundo "muted").
    -->
    <Style x:Key="TabTriggerStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.15" />
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource InputBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource InputBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource InputBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource InputBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource InputBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource InputBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="SliderTrackFill" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#26FFFFFF" />
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="PrimaryBrush" />
    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="PrimaryBrush" />
    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="PrimaryBrush" />
    <StaticResource x:Key="SliderOuterThumbBackground" ResourceKey="PrimaryBrush" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
    <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF0A0A0A" />
    <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
    <CornerRadius x:Key="SliderTrackCornerRadius">3</CornerRadius>
    <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">10</CornerRadius>

    <!-- Itens da lista de saídas: como os itens de um DropdownMenu (fundo "accent" ao passar o mouse). -->
    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="ListViewItemForeground" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ListViewItemForegroundPressed" ResourceKey="ForegroundBrush" />
    <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.15" />
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <StaticResource x:Key="TextControlBackground" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InputHoverBrush" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InputBrush" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="InputBrush" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="RingBrush" />
    <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="InputBrush" />
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <StaticResource x:Key="TextControlForeground" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="SelectionBrush" />

    <StaticResource x:Key="ComboBoxBackground" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="InputHoverBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="InputHoverBrush" />
    <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="InputFillBrush" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="InputBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="InputBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="InputBrush" />
    <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="RingBrush" />
    <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="InputBrush" />
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxForegroundPointerOver" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxForegroundPressed" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="MutedForegroundBrush" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="PopoverBrush" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="ShadBorderBrush" />
    <StaticResource x:Key="ComboBoxDropDownForeground" ResourceKey="ForegroundBrush" />
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedUnfocused" ResourceKey="AccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedUnfocused" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="ForegroundBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="ForegroundBrush" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="Transparent" />
    <CornerRadius x:Key="ComboBoxItemCornerRadius">4</CornerRadius>

    <Style x:Key="SelectStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Margin" Value="4,1" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextareaStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource SelectionBrush}" />
    </Style>
</ResourceDictionary>
