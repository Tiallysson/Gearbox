<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gearbox.Modules.Wallpaper</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>pt-BR</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets: o casco já referencia o Windows App SDK; assim os testes não herdam o SDK. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gearbox.Core\Gearbox.Core.csproj" />
    <ProjectReference Include="..\Gearbox.Interop\Gearbox.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wallpaper embutido: vai para Assets\Wallpapers ao lado do Gearbox.exe. -->
    <Content Include="Assets\Wallpapers\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gearbox.Modules.Wallpaper.Tests" />
  </ItemGroup>

</Project>
