  </data>
  <data name="Gallery_geometric_Name" xml:space="preserve">
    <value>Geometric</value>
  </data>
  <data name="Gallery_geometric_Description" xml:space="preserve">
    <value>Formas simples em equilíbrio: círculo, quadrado e triângulo com sombras suaves sobre uma grade discreta.</value>
  </data>
  <data name="Gallery_nature_Name" xml:space="preserve">
    <value>Nature</value>
  </data>
  <data name="Gallery_nature_Description" xml:space="preserve">
    <value>Cordilheiras em camadas ao pôr do sol, com névoa entre os vales e a luz dourada no horizonte.</value>
  </data>
  <data name="Gallery_livinggradient_Name" xml:space="preserve">
    <value>Living Gradient</value>
  </data>
  <data name="Gallery_livinggradient_Description" xml:space="preserve">
