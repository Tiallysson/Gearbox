  <data name="Gallery_abstractgradient_Name" xml:space="preserve">
    <value>Abstract Gradient</value>
  </data>
  <data name="Gallery_abstractgradient_Description" xml:space="preserve">
    <value>Ondas de cor que se dissolvem umas nas outras: violeta profundo, coral e pêssego, com dobras de luz suaves como seda.</value>
  </data>
  <data name="Gallery_darkminimal_Name" xml:space="preserve">
    <value>Dark Minimal</value>
  </data>
  <data name="Gallery_darkminimal_Description" xml:space="preserve">
    <value>Um horizonte escuro e silencioso. Um único arco de luz, como o nascer do sol visto do espaço.</value>
  </data>
  <data name="Gallery_aurora_Name" xml:space="preserve">
    <value>Aurora</value>
  </data>
  <data name="Gallery_aurora_Description" xml:space="preserve">
