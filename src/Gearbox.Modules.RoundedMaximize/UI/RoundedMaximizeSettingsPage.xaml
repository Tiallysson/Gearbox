<Page
    x:Class="Gearbox.Modules.RoundedMaximize.UI.RoundedMaximizeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <StackPanel Spacing="4">

        <!-- Aparência -->
        <TextBlock x:Uid="AppearanceHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="1,8,0,4" />

        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="MarginTitle" />
                    <TextBlock x:Uid="MarginDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.MarginText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                    <Slider
                        x:Uid="MarginSlider"
                        Width="200"
                        Minimum="{x:Bind ViewModel.MinMargin}"
                        Maximum="{x:Bind ViewModel.MaxMargin}"
                        StepFrequency="1"
                        TickFrequency="8"
                        TickPlacement="Outside"
                        Value="{x:Bind ViewModel.Margin, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="AccentColorTitle" />
                        <TextBlock x:Uid="AccentColorDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Uid="AccentColorToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.UseAccentColor, Mode=TwoWay}" />
                </Grid>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsCustomColorEnabled, Mode=OneWay}">
                    <TextBlock x:Uid="BorderColorTitle" />
                    <ColorPicker
                        HorizontalAlignment="Left"
                        ColorSpectrumShape="Ring"
                        IsAlphaEnabled="False"
                        IsColorChannelTextInputVisible="False"
                        IsHexInputVisible="True"
                        IsMoreButtonVisible="False"
                        Color="{x:Bind ViewModel.BorderColor, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Exclusões -->
        <TextBlock x:Uid="ExclusionsHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="1,24,0,4" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock x:Uid="ExclusionsDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="NewExclusionBox"
                        Text="{x:Bind ViewModel.NewExclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnNewExclusionKeyDown" />
                    <Button
                        x:Uid="AddExclusionButton"
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.AddExclusionCommand}" />
                </Grid>

                <Button
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind ViewModel.ForegroundButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.AddForegroundWindowCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE916;" />
                        <TextBlock Text="{x:Bind ViewModel.ForegroundButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

                <ListView
                    x:Uid="ExclusionsList"
                    MaxHeight="320"
                    ItemsSource="{x:Bind ViewModel.ExcludedProcesses}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="14" Glyph="&#xE7EF;" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" />
                                <Button
                                    x:Uid="RemoveExclusionButton"
                                    Grid.Column="2"
                                    Click="OnRemoveExclusionClick"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Tag="{x:Bind}">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <TextBlock
            x:Uid="ElevatedNote"
            Margin="1,16,0,0"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
