<Page
    x:Class="Darwin.Views.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <!-- Cabeçalho comum a todos os módulos -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <FontIcon FontSize="28" Glyph="{x:Bind ViewModel.Glyph}" />
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />
        </StackPanel>
        <TextBlock
            Margin="0,0,0,16"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Description}"
            TextWrapping="Wrap" />

        <InfoBar
            x:Uid="ModuleFaultInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasFault, Mode=OneWay}"
            Message="{x:Bind ViewModel.FaultMessage, Mode=OneWay}"
            Severity="Error" />

        <Border Style="{StaticResource DarwinCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ModuleEnabledTitle" VerticalAlignment="Center" />
                <ToggleSwitch
                    x:Uid="ModuleEnabledToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Página de configurações fornecida pelo módulo -->
        <ContentPresenter x:Name="SettingsHost" Margin="0,8,0,0" />
    </StackPanel>
</Page>
