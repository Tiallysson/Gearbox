<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Darwin.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          asInvoker: o Darwin roda com os privilégios do usuário.

          Por causa do UIPI (User Interface Privilege Isolation), um processo não elevado NÃO consegue
          mover, redimensionar nem alterar atributos de janelas de processos elevados (apps abertos
          "como administrador", Gerenciador de Tarefas, Editor do Registro...). Para que os módulos
          afetem essas janelas também, troque por:

            <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />

          Atenção: com requireAdministrator, "Iniciar com o Windows" via HKCU\...\Run deixa de funcionar
          (o Windows não eleva itens da chave Run); seria preciso usar uma tarefa agendada.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Coordenadas em pixels físicos em todos os monitores: necessário para posicionar janelas de outros apps. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
