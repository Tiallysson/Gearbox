<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Gearbox</RootNamespace>
    <AssemblyName>Gearbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Gearbox.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>pt-BR</DefaultLanguage>

    <!-- App unpackaged: sem MSIX, com o Windows App SDK embutido na pasta de saída. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Não gera MSIX (WindowsPackageType=None), mas sem isso o dotnet publish não copia o Gearbox.pri:
         a janela não carrega (XamlParseException) e os textos viram as chaves do .resw. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

    <!-- Main próprio (Program.cs) para checar a instância única antes de criar o App. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gearbox.Core\Gearbox.Core.csproj" />
    <ProjectReference Include="..\Gearbox.Interop\Gearbox.Interop.csproj" />
    <ProjectReference Include="..\Gearbox.Modules.RoundedMaximize\Gearbox.Modules.RoundedMaximize.csproj" />
    <ProjectReference Include="..\Gearbox.Modules.Wallpaper\Gearbox.Modules.Wallpaper.csproj" />
    <ProjectReference Include="..\Gearbox.Modules.Notch\Gearbox.Modules.Notch.csproj" />
    <ProjectReference Include="..\Gearbox.Modules.Dock\Gearbox.Modules.Dock.csproj" />
  </ItemGroup>

</Project>
