<Page
    x:Class="Gearbox.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <TextBlock x:Uid="GeneralTitle" Style="{StaticResource GearboxPageTitleStyle}" />

        <InfoBar
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- Iniciar com o Windows -->
        <Border Style="{StaticResource GearboxCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7E8;" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="StartupTitle" />
                    <TextBlock x:Uid="StartupDescription" Style="{StaticResource GearboxCardDescriptionStyle}" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="StartupToggle"
                    Grid.Column="2"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Tema -->
        <Border Style="{StaticResource GearboxCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="ThemeTitle" />
                    <TextBlock x:Uid="ThemeDescription" Style="{StaticResource GearboxCardDescriptionStyle}" />
                </StackPanel>
                <ComboBox
                    x:Uid="ThemeCombo"
                    Grid.Column="2"
                    MinWidth="220"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="ThemeSystem" />
                    <ComboBoxItem x:Uid="ThemeLight" />
                    <ComboBoxItem x:Uid="ThemeDark" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Logs -->
        <Border Style="{StaticResource GearboxCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE9F9;" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="LogsTitle" />
                    <TextBlock x:Uid="LogsDescription" Style="{StaticResource GearboxCardDescriptionStyle}" />
                </StackPanel>
                <Button
                    x:Uid="OpenLogsButton"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</Page>
