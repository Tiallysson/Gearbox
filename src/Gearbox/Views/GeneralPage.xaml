<Page
    x:Class="Gearbox.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <TextBlock x:Uid="GeneralTitle" Style="{StaticResource GearboxPageTitleStyle}" />

        <InfoBar
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- Iniciar com o Windows -->
        <Border Style="{StaticResource GearboxCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7E8;" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="StartupTitle" />
                    <TextBlock x:Uid="StartupDescription" Style="{StaticResource GearboxCardDescriptionStyle}" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="StartupToggle"
                    Grid.Column="2"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Tema -->
        <Border Style="{StaticResource GearboxCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="ThemeTitle" />
                    <TextBlock x:Uid="ThemeDescription" Style="{StaticResource GearboxCardDescriptionStyle}" />
                </StackPanel>
                <ComboBox
                    x:Uid="ThemeCombo"
                    Grid.Column="2"
                    MinWidth="220"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="ThemeSystem" />
                    <ComboBoxItem x:Uid="ThemeLight" />
                    <ComboBoxItem x:Uid="ThemeDark" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource GearboxCardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="UpdatesTitle" />
                        <TextBlock Style="{StaticResource GearboxCardDescriptionStyle}" Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.InstallUpdateCommand}"
                            Content="{x:Bind ViewModel.InstallButtonText, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsInstallVisible, Mode=OneWay}" />
                        <Button
                            x:Uid="CheckUpdatesButton"
                            Command="{x:Bind ViewModel.CheckForUpdatesNowCommand}"
                            IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="16" Padding="36,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="AutoUpdateTitle" VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Uid="AutoUpdateToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnSpacing="16" Padding="36,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="PrereleaseTitle" />
                        <TextBlock x:Uid="PrereleaseDescription" Style="{StaticResource GearboxCardDescriptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Uid="PrereleaseToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        IsEnabled="{x:Bind ViewModel.CanChangePrereleases}"
                        IsOn="{x:Bind ViewModel.IncludePrereleases, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Logs -->
        <Border Style="{StaticResource GearboxCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE9F9;" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="LogsTitle" />
                    <TextBlock x:Uid="LogsDescription" Style="{StaticResource GearboxCardDescriptionStyle}" />
                </StackPanel>
                <Button
                    x:Uid="OpenLogsButton"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</Page>
